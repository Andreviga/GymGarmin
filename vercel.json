{
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api/index"
    }
  ],
  "functions": {
    "api/index.py": {
      "includeFiles": "gymgarmin/**",
      "maxDuration": 30
    }
  },
  "crons": [
    {
      "path": "/api/cron/garmin-sync",
      "schedule": "13 2 * * *"
    },
    {
      "path": "/api/cron/youtube-sync",
      "schedule": "41 9 * * *"
    }
  ]
}
